# Kopieer dit bestand naar .env en vul je eigen waarden in. Zet .env NOOIT op GitHub.

# --- Taalmodel -------------------------------------------------------------------------------
# NVIDIA (OpenAI-compatibele API). Alleen testgesprekken: deze dienst draait buiten de EU.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.3-70b-instruct
# Zet op false als het model geen tool calling ondersteunt (dan zoekt alleen de server in de lesstof).
LLM_TOOLS=true

# Leeg laten = testmodus zonder taalmodel. LLM_PROVIDER=mock forceert de testmodus.
# LLM_PROVIDER=mock

# --- Embeddings (semantisch zoeken in de lesstof) ---------------------------------------------
# Standaard dezelfde NVIDIA-sleutel. Meertalig model, dus geschikt voor Nederlands.
EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
# EMBED_BASE_URL=
# EMBED_API_KEY=

# --- Web search ------------------------------------------------------------------------------
# Willekeurige tekst voor SearXNG (bijvoorbeeld 40 tekens).
SEARXNG_SECRET=verander-mij-in-iets-willekeurigs
